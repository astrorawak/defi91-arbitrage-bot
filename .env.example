# DeFi91 Arbitrage Engine - Environment Variables
# Copy file ini menjadi .env dan isi dengan nilai Anda

# RPC Endpoint Base Network
BASE_RPC_URL=https://mainnet.base.org

# WebSocket (opsional, untuk real-time block subscription)
BASE_WSS_URL=

# Private Key wallet bot (TANPA awalan 0x)
PRIVATE_KEY=

# Alamat Smart Contract ArbitrageExecutor yang sudah di-deploy
ARBITRAGE_CONTRACT=

# Minimum profit per trade (dalam USD)
MIN_PROFIT_USD=0.50

# Maximum gas price yang bersedia dibayar (dalam Gwei)
MAX_GAS_GWEI=0.5

# Priority fee (dalam Gwei)
PRIORITY_FEE_GWEI=0.01

# Interval scanning (dalam milidetik)
SCAN_INTERVAL_MS=500

# Slippage tolerance (dalam basis points, 50 = 0.5%)
SLIPPAGE_BPS=50

# Mode: true = simulasi saja, false = eksekusi nyata
DRY_RUN=true
